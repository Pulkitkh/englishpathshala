# ------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# Everything here is OPTIONAL except ADMIN_PASSWORD (for /admin).
# ------------------------------------------------------------------

# Your live domain. Used for SEO tags, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://englishpathshala.in

# Password for the private enquiry dashboard at /admin.
# Use something long. Anyone with this password can read student details.
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Optional: separate secret used to sign the admin login cookie.
# If unset, ADMIN_PASSWORD is used. Changing it logs you out everywhere.
SESSION_SECRET=

# ------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------
# Leave DATABASE_URL empty and enquiries are saved to ./data/leads.json
# (fine locally and on a VPS). On Vercel/Netlify the filesystem is
# read-only, so set a free Postgres URL here (Neon, Supabase, Railway).
DATABASE_URL=

# Set to "disable" only if your Postgres does not use SSL (rare).
DATABASE_SSL=

# ------------------------------------------------------------------
# Notifications (both optional — the site works without them)
# ------------------------------------------------------------------
# Email yourself every new enquiry. Free tier: https://resend.com
RESEND_API_KEY=
NOTIFY_EMAIL_TO=bhavya@example.com
NOTIFY_EMAIL_FROM=English Pathshala <onboarding@resend.dev>

# Or POST every enquiry as JSON to Zapier / Make / Google Sheets / n8n.
LEAD_WEBHOOK_URL=
